# Copy to .env and adjust. No IBKR password here: IBC holds it in ~/ibc/config.ini.

# --- Gateway connection ---------------------------------------------------
IB_HOST=127.0.0.1
# 4001 = IB Gateway live, 4002 = IB Gateway paper, 7496/7497 = TWS live/paper
IB_PORT=4001
IB_CLIENT_ID=17
# Leave blank to use the single managed account returned by the Gateway
IB_ACCOUNT=
# Refuse to place orders from this client, no matter what
IB_READONLY=true
IB_CONNECT_TIMEOUT=20
# Let `ib-agent sync` launch the Gateway if it is not running
IB_AUTO_START_GATEWAY=true
# Quotes: 1 live, 2 frozen, 3 delayed (live where subscribed), 4 delayed-frozen
IB_MARKET_DATA_TYPE=3

# --- Headless display for the Gateway GUI --------------------------------
XVFB_DISPLAY=:99
XVFB_GEOMETRY=1920x1080x24
GATEWAY_WAIT_SECONDS=180
IBC_PATH=/opt/ibc
IBC_INI=${HOME}/ibc/config.ini
TWS_PATH=${HOME}/Jts

# --- Storage --------------------------------------------------------------
IB_DATA_DIR=./data

# --- Optional: Flex Web Service (token-based, no Gateway needed) ---------
# Create at IBKR: Performance & Reports > Flex Queries > Flex Web Service
IB_FLEX_TOKEN=
IB_FLEX_QUERY_ID=
